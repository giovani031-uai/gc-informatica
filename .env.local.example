# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Supabase
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privada, usada só no servidor (nunca no navegador). Necessária a partir do módulo do admin.
SUPABASE_SERVICE_ROLE_KEY=
